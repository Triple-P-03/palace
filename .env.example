# Required for fresh AI-generated lessons. Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite for broad free-tier availability.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional for MongoDB persistence. Without this, the browser stores topics and lessons locally.
MONGODB_URI=
MONGODB_DB=memory-palace
